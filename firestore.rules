rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /sopFiles/{fileId} {
      allow read, write: if true;
    }
    match /messengerialRecords/{recordId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    match /tickets/{ticketId} {
      allow read, write: if true;
    }
    match /satisfactionFeedbacks/{feedbackId} {
      allow read, write: if true;
    }
  }
}

